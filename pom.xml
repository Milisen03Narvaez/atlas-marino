<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml = archivo de configuración de Maven (IntelliJ lo lee al abrir el proyecto).
  Aquí se declaran las LIBRERÍAS que usa el proyecto. Cada <dependency> es una pieza del rompecabezas MVC:
    - spring-boot-starter-web        -> Spring MVC (controladores) + servidor Tomcat embebido
    - spring-boot-starter-thymeleaf  -> motor de plantillas HTML (la VISTA)
    - spring-boot-starter-data-jpa   -> JPA/Hibernate + repositorios (acceso a la base de datos)
    - spring-boot-starter-validation -> anotaciones @NotBlank, @Size, @Valid (validar el formulario del admin)
    - postgresql                     -> driver JDBC para conectarse a PostgreSQL
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>com.oceano</groupId>
    <artifactId>atlas-marino</artifactId>
    <version>1.0.0</version>
    <name>atlas-marino</name>
    <description>Atlas de animales marinos - Spring Boot MVC + Thymeleaf + PostgreSQL</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
